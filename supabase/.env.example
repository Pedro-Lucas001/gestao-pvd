# Contrato em inglês: supabase/migrations/ e frontend atual.
# Valores privados somente nos segredos das Edge Functions. Nunca em VITE_*.
# Preencha somente as integrações escolhidas; campos vazios não as ativam.

# Base: origens exatas sem caminho/barra final; múltiplas separadas por vírgula.
APP_ALLOWED_ORIGINS=
PUBLIC_SITE_URL=
ONLINE_RATE_SALT=
INTEGRATION_WORKER_SECRET=

# Pix manual: o administrador confere o crédito no banco.
PAYMENT_MODE=manual_pix
PIX_KEY=
PIX_MERCHANT_NAME=
PIX_MERCHANT_CITY=

# Pix/cartão online via Mercado Pago. Começar no ambiente de teste compatível.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_COLLECTOR_ID=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_LIVE_MODE=false

# WhatsApp Business Platform / Cloud API e templates aprovados.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_STATUS_TEMPLATE=
WHATSAPP_ONLINE_STATUS_TEMPLATE=
WHATSAPP_ONLINE_PAYMENT_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_MENU_URL=

# API OpenAI: habilitar exportação somente após configurar consentimento.
OPENAI_API_KEY=
OPENAI_SALES_MODEL=gpt-4.1-mini
AI_CUSTOMER_EXPORT_ENABLED=false
AI_DAILY_REQUEST_LIMIT=20

# O Supabase hospedado fornece SUPABASE_URL, SUPABASE_ANON_KEY e
# SUPABASE_SERVICE_ROLE_KEY ao servidor. Não substituir por credenciais do site.
# O contrato independente em português usa supabase/eco.env.example.
